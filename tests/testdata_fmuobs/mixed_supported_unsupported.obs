SUMMARY_OBSERVATION A3_WOPR_VALYSAR_01_08_2019 {VALUE = 266; ERROR = 100; ERROR_MODE = ABS; DATE = 2019-08-01; KEY = WOPRL__1:A3; LOCALIZATION { EAST = 462753.44; NORTH = 5932869.64; RADIUS = 1000.0;}; };
